<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beige"
    style="@style/SCREEN"
    tools:context=".memories">

    <!-- Image slots -->
    <ImageView
        android:id="@+id/image1"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:background="@android:color/darker_gray"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

    <ImageView
        android:id="@+id/image2"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:background="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@id/image1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

    <ImageView
        android:id="@+id/image3"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:background="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@id/image2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"/>

    <!-- Music controls -->
    <LinearLayout
        android:id="@+id/musicControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/image3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/selectMusic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BUTTON"
            android:text="Add Music" />

        <Button
            android:id="@+id/play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BUTTON"
            android:text="Play" />

        <Button
            android:id="@+id/pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BUTTON"
            android:text="Pause" />

        <Button
            android:id="@+id/stopMusic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BUTTON"
            android:text="Stop" />
    </LinearLayout>

    <!-- Buttons to add memories -->
    <LinearLayout
        android:id="@+id/memoryButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/musicControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/addMem1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BUTTON"
            android:text="Add Memory" />

        <Button
            android:id="@+id/addMem2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BUTTON"
            android:text="Add Memory" />

        <Button
            android:id="@+id/addMem3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BUTTON"
            android:text="Add Memory" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
